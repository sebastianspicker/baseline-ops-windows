# EditorConfig for BaselineOps for Windows
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.ps1]
indent_size = 2

[*.psm1]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.json]
indent_size = 2
