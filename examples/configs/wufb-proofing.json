{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Example Windows Update for Business proofing configuration",
  
  "UpdateSettings": {
    "DeferFeatureUpdates": true,
    "DeferFeatureUpdatesPeriodDays": 30,
    "DeferQualityUpdates": true,
    "DeferQualityUpdatesPeriodDays": 7,
    "PauseFeatureUpdates": false,
    "PauseQualityUpdates": false,
    "BranchReadinessLevel": "SemiAnnualChannel"
  },
  
  "DeliveryOptimization": {
    "DOMode": "HttpOnly",
    "DODownloadMode": 1,
    "DOMaxCacheSize": 20
  },
  
  "TargetReleaseVersion": {
    "Enabled": true,
    "Version": "22H2"
  },
  
  "Proof": {
    "OutFile": "C:\\ProgramData\\SecurityHardening\\wufb-proof.json"
  }
}
